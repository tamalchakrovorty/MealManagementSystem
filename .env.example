# PostgreSQL / CockroachDB connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT secret for session tokens (change in production)
JWT_SECRET=your-secret-key-here

# Optional: path to SSL certificate for CockroachDB
# SSL_CERT_PATH=./certs/root.crt

# Optional: allowed dev origins (comma-separated IPs for local network access)
# ALLOWED_DEV_ORIGINS=192.168.0.113,192.168.0.230
